	$(MAKE) -f apps/sequential_tests/matrixMul8/CMakeFiles/matrixMul8.powerc.dir/build.make apps/sequential_tests/matrixMul8/CMakeFiles/matrixMul8.powerc.dir/build
.PHONY : matrixMul8.powerc/fast

