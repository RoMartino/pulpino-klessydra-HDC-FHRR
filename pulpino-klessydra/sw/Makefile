cnn_layer.elf: cmake_check_build_system
	$(MAKE) -f CMakeFiles/Makefile2 cnn_layer.elf
.PHONY : cnn_layer.elf

# fast build rule for target.
cnn_layer.elf/fast:
	$(MAKE) -f apps/sequential_tests/cnn_layer/CMakeFiles/cnn_layer.elf.dir/build.make apps/sequential_tests/cnn_layer/CMakeFiles/cnn_layer.elf.dir/build
.PHONY : cnn_layer.elf/fast

